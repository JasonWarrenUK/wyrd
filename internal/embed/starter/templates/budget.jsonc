{
	// Budget template — defines fields for budget envelope nodes.
	"type_name": "budget",
	"fields": {
		"category": {
			"type": "string",
			"required": true,
			"description": "Budget category name (used by `wyrd spend` to match this envelope)"
		},
		"currency": {
			"type": "string",
			"default": "GBP",
			"description": "ISO 4217 currency code"
		},
		"period": {
			"type": "enum",
			"values": ["week", "month", "quarter", "year"],
			"default": "month",
			"description": "Budget period"
		},
		"allocated": {
			"type": "number",
			"required": true,
			"description": "Amount allocated for this period"
		},
		"carry_over": {
			"type": "boolean",
			"default": false,
			"description": "Whether unspent allocation rolls over into the next period"
		},
		"warn_at": {
			"type": "number",
			"default": 0.8,
			"description": "Fraction of allocated at which caution status triggers"
		},
		"spend_log": {
			"type": "object",
			"default": [],
			"description": "Array of spend entries recorded against this budget"
		}
	}
}
